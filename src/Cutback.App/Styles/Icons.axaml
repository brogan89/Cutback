<!--
  Icon geometry from Lucide (https://lucide.dev, ISC; see THIRD-PARTY-NOTICES.md). Each is the
  24x24 stroke artwork with rect/circle elements rewritten as path arcs. Use them as
  <Path Data="{StaticResource IconName}" /> inside a Classes="icon" button, which supplies the
  2px round stroke. Keys are Icon<PascalCase of the Lucide name>. Add new icons here and to the
  notices file.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- audio-lines: Detect silence -->
  <StreamGeometry x:Key="IconAudioLines">M2 10v3 M6 6v11 M10 3v18 M14 8v7 M18 5v13 M22 10v3</StreamGeometry>

  <!-- message-square-x: Remove filler words -->
  <StreamGeometry x:Key="IconMessageSquareX">M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z M14.5 8.5l-5 5 M9.5 8.5l5 5</StreamGeometry>

  <!-- captions: Transcript -->
  <StreamGeometry x:Key="IconCaptions">M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M7 15h4 M15 15h2 M7 11h2 M13 11h4</StreamGeometry>

  <!-- upload: Export -->
  <StreamGeometry x:Key="IconUpload">M12 3v12 M17 8l-5-5-5 5 M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4</StreamGeometry>

  <!-- play / pause: transport -->
  <StreamGeometry x:Key="IconPlay">M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z</StreamGeometry>
  <StreamGeometry x:Key="IconPause">M15 3h3a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M6 3h3a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z</StreamGeometry>

  <!-- film: empty state -->
  <StreamGeometry x:Key="IconFilm">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M7 3v18 M3 7.5h4 M3 12h18 M3 16.5h4 M17 3v18 M17 7.5h4 M17 16.5h4</StreamGeometry>

  <!-- gamepad-2: Detect idle gameplay -->
  <StreamGeometry x:Key="IconGamepad2">M6 11h4 M8 9v4 M15 12h.01 M18 10h.01 M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z</StreamGeometry>

</ResourceDictionary>
