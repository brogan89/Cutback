<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cutback.App.App"
             RequestedThemeVariant="Dark">
  <!-- Dark only: the palette in Styles/Theme.axaml has no light variant. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- avares authority is the assembly name (Cutback), not the project name. -->
        <ResourceInclude Source="avares://Cutback/Styles/Theme.axaml" />
        <ResourceInclude Source="avares://Cutback/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Cutback/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
