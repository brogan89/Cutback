<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cutback.App.ViewModels"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        xmlns:controls="using:Cutback.App.Controls"
        x:Class="Cutback.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        Background="#1B1B1F">

  <Window.KeyBindings>
    <KeyBinding Gesture="Space" Command="{Binding PlayPauseCommand}" />
    <KeyBinding Gesture="Cmd+O" Command="{Binding OpenVideoCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenVideoCommand}" />
    <KeyBinding Gesture="Cmd+Shift+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Cmd+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Cmd+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Cmd+N" Command="{Binding NewProjectCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.toolbar">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#9A9AA6" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">

    <!-- Menu -->
    <Menu Grid.Row="0" Background="#1B1B1F">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="_Open Video…" Command="{Binding OpenVideoCommand}" />
        <MenuItem Header="Open _Project…" Command="{Binding OpenProjectCommand}" />
        <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding RecentFiles.Count}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:RecentFileItem">
              <Setter Property="Header" Value="{Binding Display}" />
              <Setter Property="Command" Value="{Binding Open}" />
              <Setter Property="CommandParameter" Value="{Binding Path}" />
              <Setter Property="ToolTip.Tip" Value="{Binding Path}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Save" Command="{Binding SaveProjectCommand}" />
        <MenuItem Header="Save _As…" Command="{Binding SaveProjectAsCommand}" />
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <Border Grid.Row="1" Background="#242429" Padding="10,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="toolbar" Command="{Binding OpenVideoCommand}" Content="Open video…" />
        <Button Classes="toolbar" Command="{Binding DetectSilenceCommand}" Content="Detect silence" />
        <ToggleButton Classes="toolbar" IsChecked="{Binding IsSettingsOpen}" Content="Detection settings" />
        <Button Classes="toolbar" Command="{Binding SaveProjectCommand}" Content="Save" />
        <TextBlock Classes="dim" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding SourceFileName}" />
      </StackPanel>
    </Border>

    <!-- Banners -->
    <StackPanel Grid.Row="2">
      <Border Background="#5A1E24" Padding="12,8" IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FFE3E6" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissErrorCommand}" Margin="12,0,0,0" VerticalAlignment="Top" />
        </Grid>
      </Border>
      <Border Background="#5A4A1E" Padding="12,8" IsVisible="{Binding HasWarning}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding WarningMessage}" TextWrapping="Wrap" Foreground="#FFF1C8" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissWarningCommand}" Margin="12,0,0,0" VerticalAlignment="Top" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- Video + optional settings panel side by side (the panel never overlaps the video). -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">

      <!-- Overlay content MUST be inside the VideoView (airspace), never a sibling. -->
      <Border Grid.Column="0" Background="Black" ClipToBounds="True">
        <vlc:VideoView x:Name="VideoView">
          <Panel DragDrop.AllowDrop="True" Background="Transparent">
            <StackPanel IsVisible="{Binding !HasProject}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
              <TextBlock Text="Drop a video here" FontSize="22" Foreground="#C8C8D0" HorizontalAlignment="Center" />
              <TextBlock Text="or use Open video… to get started" Classes="dim" HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>
        </vlc:VideoView>
      </Border>

      <!-- Detection settings -->
      <Border Grid.Column="1" Width="280" Background="#202024" BorderBrush="#2E2E35" BorderThickness="1,0,0,0"
              Padding="16" IsVisible="{Binding IsSettingsOpen}">
        <StackPanel Spacing="14">
          <TextBlock Text="Detection settings" FontWeight="SemiBold" FontSize="15" />

          <StackPanel Spacing="4">
            <TextBlock Text="Silence threshold (dB)" />
            <NumericUpDown Value="{Binding SilenceThresholdDb}" Minimum="-80" Maximum="0" Increment="1" FormatString="0.0" />
            <TextBlock Classes="dim" TextWrapping="Wrap" FontSize="12" Text="Audio quieter than this counts as silence. Raise it (towards 0) if breaths and room noise are not being cut." />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Minimum silence (ms)" />
            <NumericUpDown Value="{Binding MinSilenceMs}" Minimum="50" Maximum="5000" Increment="50" FormatString="0" />
            <TextBlock Classes="dim" TextWrapping="Wrap" FontSize="12" Text="Pauses shorter than this are left alone." />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Padding (ms)" />
            <NumericUpDown Value="{Binding PaddingMs}" Minimum="0" Maximum="500" Increment="10" FormatString="0" />
            <TextBlock Classes="dim" TextWrapping="Wrap" FontSize="12" Text="Extra audio kept on each side of a cut so words are not clipped." />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Minimum keep (ms)" />
            <NumericUpDown Value="{Binding MinKeepMs}" Minimum="0" Maximum="2000" Increment="20" FormatString="0" />
            <TextBlock Classes="dim" TextWrapping="Wrap" FontSize="12" Text="Kept fragments shorter than this are removed with their neighbours to avoid a stuttering result." />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Detect silence" Command="{Binding DetectSilenceCommand}" />
            <Button Content="Reset" Command="{Binding ResetSettingsCommand}" />
          </StackPanel>

          <TextBlock Classes="dim" TextWrapping="Wrap" FontSize="12"
                     Text="Re-running detection replaces automatic cuts but never touches segments you have edited by hand." />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Transport -->
    <Border Grid.Row="4" Background="#242429" Padding="10,6">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <Button Grid.Column="0" Classes="toolbar" MinWidth="80" Command="{Binding PlayPauseCommand}"
                Content="{Binding IsPlaying, Converter={x:Static vm:Converters.PlayPauseLabel}}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="4">
          <TextBlock Text="{Binding PositionText}" FontFamily="Menlo,Consolas,monospace" />
          <TextBlock Text="/" Classes="dim" />
          <TextBlock Text="{Binding DurationText}" Classes="dim" FontFamily="Menlo,Consolas,monospace" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Timeline -->
    <Border Grid.Row="5" Height="180" BorderBrush="#2E2E35" BorderThickness="0,1,0,0">
      <controls:TimelineControl Segments="{Binding Segments}"
                                Waveform="{Binding Waveform}"
                                Duration="{Binding DurationSeconds}"
                                Position="{Binding PositionSeconds}"
                                SeekCommand="{Binding SeekCommand}"
                                ToggleSegmentCommand="{Binding ToggleSegmentCommand}"
                                MoveBoundaryCommand="{Binding MoveBoundaryCommand}" />
    </Border>

    <!-- Status / progress -->
    <Border Grid.Row="6" Background="#242429" Padding="10,4" MinHeight="28">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Classes="dim" VerticalAlignment="Center" Text="{Binding BusyMessage}" IsVisible="{Binding IsBusy}" />
        <TextBlock Grid.Column="0" Classes="dim" VerticalAlignment="Center" Text="{Binding StatusMessage}" IsVisible="{Binding !IsBusy}" />
        <ProgressBar Grid.Column="1" Margin="12,0,0,0" Height="6" VerticalAlignment="Center"
                     IsVisible="{Binding IsBusy}"
                     IsIndeterminate="{Binding IsBusyIndeterminate}"
                     Minimum="0" Maximum="1" Value="{Binding BusyProgress}" />
      </Grid>
    </Border>

  </Grid>

</Window>
