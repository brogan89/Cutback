<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cutback.App.ViewModels"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        xmlns:controls="using:Cutback.App.Controls"
        x:Class="Cutback.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Space" Command="{Binding PlayPauseCommand}" />
    <KeyBinding Gesture="Cmd+O" Command="{Binding OpenVideoCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenVideoCommand}" />
    <KeyBinding Gesture="Cmd+Shift+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Cmd+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Cmd+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Cmd+N" Command="{Binding NewProjectCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
    <KeyBinding Gesture="Cmd+E" Command="{Binding ExportCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" />
    <KeyBinding Gesture="Cmd+Shift+E" Command="{Binding ExportTranscriptCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExportTranscriptCommand}" />
    <KeyBinding Gesture="Cmd+OemComma" Command="{Binding ShowPreferencesCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ShowPreferencesCommand}" />
    <KeyBinding Gesture="Cmd+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Cmd+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteHoveredSegmentCommand}" />
    <KeyBinding Gesture="Back" Command="{Binding DeleteHoveredSegmentCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">

    <!-- Menu -->
    <Menu Grid.Row="0">
      <!-- Shortcut hints (InputGesture) are set in code-behind so the modifier matches the OS. -->
      <MenuItem Header="_File">
        <MenuItem x:Name="NewProjectMenuItem" Header="_New Project" Command="{Binding NewProjectCommand}" />
        <MenuItem x:Name="OpenVideoMenuItem" Header="_Open Video…" Command="{Binding OpenVideoCommand}" />
        <MenuItem x:Name="OpenProjectMenuItem" Header="Open _Project…" Command="{Binding OpenProjectCommand}" />
        <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding RecentFiles.Count}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:RecentFileItem">
              <Setter Property="Header" Value="{Binding Display}" />
              <Setter Property="Command" Value="{Binding Open}" />
              <Setter Property="CommandParameter" Value="{Binding Path}" />
              <Setter Property="ToolTip.Tip" Value="{Binding Path}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
        <Separator />
        <MenuItem x:Name="SaveMenuItem" Header="_Save" Command="{Binding SaveProjectCommand}" />
        <MenuItem x:Name="SaveAsMenuItem" Header="Save _As…" Command="{Binding SaveProjectAsCommand}" />
        <Separator />
        <MenuItem x:Name="ExportMenuItem" Header="_Export…" Command="{Binding ExportCommand}" />
        <MenuItem x:Name="ExportTranscriptMenuItem" Header="Export _Transcript…" Command="{Binding ExportTranscriptCommand}" />
        <Separator />
        <MenuItem Header="_Preferences…" Command="{Binding ShowPreferencesCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoMenuItem" Header="_Undo" Command="{Binding UndoCommand}" />
        <MenuItem x:Name="RedoMenuItem" Header="_Redo" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="_Transcribe" Command="{Binding TranscribeCommand}" />
        <MenuItem Header="Remove _Filler Words" Command="{Binding RemoveFillerWordsCommand}" />
        <Separator />
        <MenuItem Header="_Detection Settings…" Command="{Binding ShowDetectionSettingsCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Transcript" ToggleType="CheckBox" IsChecked="{Binding IsTranscriptOpen, Mode=TwoWay}" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: icon buttons, names in tooltips. Export's tooltip carries the shortcut and is set in code-behind. -->
    <Border Grid.Row="1" Classes="bar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
          <Button Classes="icon" Command="{Binding DetectSilenceCommand}" ToolTip.Tip="Detect silence">
            <Path Data="{StaticResource IconAudioLines}" />
          </Button>
          <Button Classes="icon" Command="{Binding RemoveFillerWordsCommand}" ToolTip.Tip="Remove filler words">
            <Path Data="{StaticResource IconMessageSquareX}" />
          </Button>
          <ToggleButton Classes="icon" IsChecked="{Binding IsTranscriptOpen}" ToolTip.Tip="Transcript">
            <Path Data="{StaticResource IconCaptions}" />
          </ToggleButton>
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="dim" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{Binding SourceFileName}" TextTrimming="CharacterEllipsis" Margin="16,0" />
        <Button Grid.Column="2" x:Name="ExportButton" Classes="icon accent" Command="{Binding ExportCommand}">
          <Path Data="{StaticResource IconUpload}" />
        </Button>
      </Grid>
    </Border>

    <!-- Banners -->
    <StackPanel Grid.Row="2">
      <Border Classes="banner error" IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissErrorCommand}" Margin="12,0,0,0" VerticalAlignment="Top" />
        </Grid>
      </Border>
      <Border Classes="banner warning" IsVisible="{Binding HasWarning}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding WarningMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissWarningCommand}" Margin="12,0,0,0" VerticalAlignment="Top" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- Video + optional transcript panel side by side (the panel never overlaps the video). -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">

      <!-- Overlay content MUST be inside the VideoView (airspace), never a sibling. -->
      <Border Grid.Column="0" Background="{DynamicResource VideoBackgroundBrush}" ClipToBounds="True">
        <vlc:VideoView x:Name="VideoView">
          <Panel DragDrop.AllowDrop="True" Background="Transparent">
            <StackPanel IsVisible="{Binding !HasProject}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <Path Classes="illustration" Data="{StaticResource IconFilm}" HorizontalAlignment="Center" />
              <TextBlock Text="Drop a video here" FontSize="22" Foreground="{DynamicResource TextPlaceholderBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="or use File › Open Video… to get started" Classes="dim" HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>
        </vlc:VideoView>
      </Border>

      <!-- Transcript -->
      <Border Grid.Column="1" Width="340" Classes="panel" IsVisible="{Binding IsTranscriptOpen}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="16">
          <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Transcript" Classes="heading" />
            <TextBlock Classes="dim hint"
                       Text="Click a word to cut or restore it. Drag to select a run. Cmd/Ctrl+click to play from a word." />
            <Button Content="Remove filler words" Command="{Binding RemoveFillerWordsCommand}" IsVisible="{Binding HasTranscript}" />
          </StackPanel>

          <Border Grid.Row="1" Classes="banner warning" Padding="10,8" CornerRadius="4" Margin="0,10,0,0" IsVisible="{Binding IsTranscriptStale}">
            <StackPanel Spacing="6">
              <TextBlock Classes="hint"
                         Text="The source video changed since this transcript was made. Cut words may not line up." />
              <Button Content="Transcribe again" Command="{Binding TranscribeCommand}" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="2" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding !HasTranscript}">
            <TextBlock Text="No transcript yet" HorizontalAlignment="Center" />
            <Button Content="Transcribe" Command="{Binding TranscribeCommand}" HorizontalAlignment="Center" />
            <TextBlock Classes="dim hint" TextAlignment="Center"
                       Text="Runs on this computer. The first run downloads a ~150 MB speech model." />
          </StackPanel>

          <ScrollViewer Grid.Row="2" Margin="0,12,0,0" IsVisible="{Binding HasTranscript}" HorizontalScrollBarVisibility="Disabled">
            <controls:TranscriptControl Words="{Binding Transcript}"
                                        Segments="{Binding Segments}"
                                        CurrentWordIndex="{Binding CurrentWordIndex}"
                                        CutWordsCommand="{Binding CutWordsCommand}"
                                        SeekToWordCommand="{Binding SeekToWordCommand}" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Transport -->
    <Border Grid.Row="4" Classes="bar">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <Button Grid.Column="0" Classes="icon" Command="{Binding PlayPauseCommand}" ToolTip.Tip="{Binding PlayPauseTooltip}">
          <Panel>
            <Path Data="{StaticResource IconPlay}" IsVisible="{Binding !IsPlaying}" />
            <Path Data="{StaticResource IconPause}" IsVisible="{Binding IsPlaying}" />
          </Panel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="4">
          <TextBlock Classes="mono" Text="{Binding PositionText}" />
          <TextBlock Classes="dim" Text="/" />
          <TextBlock Classes="dim mono" Text="{Binding DurationText}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Timeline -->
    <Border Grid.Row="5" Height="180" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <controls:TimelineControl Segments="{Binding Segments}"
                                Waveform="{Binding Waveform}"
                                Duration="{Binding DurationSeconds}"
                                Position="{Binding PositionSeconds}"
                                SeekCommand="{Binding SeekCommand}"
                                ToggleSegmentCommand="{Binding ToggleSegmentCommand}"
                                MoveBoundaryCommand="{Binding MoveBoundaryCommand}"
                                CreateSectionCommand="{Binding CreateSectionCommand}"
                                DeleteSegmentCommand="{Binding DeleteSegmentCommand}"
                                HoveredSegment="{Binding HoveredSegmentIndex, Mode=OneWayToSource}" />
    </Border>

    <!-- Status / progress -->
    <Border Grid.Row="6" Classes="bar" Padding="10,4" MinHeight="28">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="dim" VerticalAlignment="Center" Text="{Binding BusyMessage}" IsVisible="{Binding IsBusy}" />
        <TextBlock Grid.Column="0" Classes="dim" VerticalAlignment="Center" Text="{Binding StatusMessage}" IsVisible="{Binding !IsBusy}" />
        <ProgressBar Grid.Column="1" Margin="12,0,0,0" Height="6" VerticalAlignment="Center"
                     IsVisible="{Binding IsBusy}"
                     IsIndeterminate="{Binding IsBusyIndeterminate}"
                     Minimum="0" Maximum="1" Value="{Binding BusyProgress}" />
        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelBusyCommand}" IsVisible="{Binding CanCancelBusy}"
                Margin="12,0,0,0" Padding="10,2" VerticalAlignment="Center" />
      </Grid>
    </Border>

  </Grid>

</Window>
