<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cutback.App.Views.SaveChangesDialog"
        Title="Unsaved changes"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#242429">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="14" />
    <TextBlock Text="Your changes will be lost if you don't save them." Foreground="#9A9AA6" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="DiscardButton" Content="Don't Save" MinWidth="90" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" IsCancel="True" />
      <Button x:Name="SaveButton" Content="Save" MinWidth="90" IsDefault="True" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
